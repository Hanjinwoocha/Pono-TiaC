@model ASI.Basecode.Services.ServiceModels.ReservationsPageViewModel
@{
    ViewData["Title"] = "Manage Borrow Requests & Active Loans";

    // Equipment photo shown on each request / loan card (an icon when the item has none)
    void Thumb(ASI.Basecode.Data.Models.EquipmentItem item)
    {
        <div class="res-thumb flex-shrink-0">
            @if (!string.IsNullOrEmpty(item?.ImagePath))
            {
                <img src="@item.ImagePath" alt="@item.BrandModel" loading="lazy" />
            }
            else
            {
                <i class="bi bi-box-seam"></i>
            }
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        /* Same look as the fields on the Change Info Request form */
        .res-card {
            background-color: #f6e6da;
            border: 1.5px solid var(--d-red);
            border-radius: 8px;
        }

            .res-card.is-approved { border-color: var(--bs-primary); }
            .res-card.is-active { border-color: var(--bs-success); }
            .res-card.is-warning { border-color: var(--bs-warning); }
            .res-card.is-overdue { border-color: var(--bs-danger); border-width: 2px; }

        /* Details on the left, status badge (if any) and photo on the right */
        .res-body {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
        }

            .res-body .res-details {
                flex: 1 1 auto;
                min-width: 0;
            }

            .res-body .res-side {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: .5rem;
                flex-shrink: 0;
            }

        .res-thumb {
            width: 96px;
            height: 96px;
            border-radius: 8px;
            overflow: hidden;
            background: #f1d3c0;
            border: 1px solid rgba(90, 0, 0, .2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--d-maroon);
            font-size: 1.6rem;
        }

            .res-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .res-pager .page-link {
            cursor: pointer;
        }
    </style>
}

<div class="dash-header mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="dash dash-name m-0">Borrow Requests & Active Loans</h1>
        <p class="dash-sub">Review incoming student requests, approve or decline borrowings, and process returns.</p>
    </div>
    <partial name="_UserBadge" />
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-controller="Custodian" asp-action="Reservations" class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.Search" class="form-control dash-search-input"
                   placeholder="Search by borrower name, ID, or item code..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select dash-search-input">
                <option value="">All Equipment Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn dash-btn-reserve w-100">Filter</button>
        </div>
    </div>
</form>

<div class="row g-4 align-items-start">  @* each card fits its own content (no stretching to match the other column) *@
    <div class="col-xl-6">
        <div class="dash-card">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-hourglass-split text-warning me-1"></i> Pending Approval Queue</h4>
                <span class="badge bg-danger rounded-pill">@Model.Pending.Count Pending</span>
            </div>

            <div class="d-flex flex-column gap-3" data-paged="1">
                @foreach (var r in Model.Pending)
                {
                    <div class="p-3 res-card" data-page-item>
                        <div class="res-body mb-3">
                            <div class="res-details">
                                <h5 class="fw-bold mb-0">@r.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small d-block mb-2">Code: @r.EquipmentItem.ItemCode</span>
                                <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>@r.Borrower.FirstName @r.Borrower.LastName</strong> (@r.Borrower.UserId)</div>
                                <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>@($"{r.RequestedPickupDate:MMM d, yyyy - h:mm tt}")</strong></div>
                                <div class="small text-muted"><i class="bi bi-clock me-1"></i> Est. Return: <strong>@($"{r.EstimatedReturnDate:MMM d, yyyy - h:mm tt}")</strong></div>
                            </div>
                            <div class="res-side">
                                @{ Thumb(r.EquipmentItem); }
                            </div>
                        </div>
                        <div class="d-flex gap-2 border-top pt-2">
                            <button type="button" class="btn btn-sm btn-outline-danger w-50" data-bs-toggle="modal" data-bs-target="#declineModal" data-id="@r.Id">
                                <i class="bi bi-x-circle me-1"></i> Decline
                            </button>
                            <button type="button" class="btn btn-sm dash-btn-reserve w-50" data-bs-toggle="modal" data-bs-target="#approveModal" data-id="@r.Id">
                                <i class="bi bi-check-circle me-1"></i> Approve Request
                            </button>
                        </div>
                    </div>
                }
                @if (!Model.Pending.Any())
                {
                    <div class="text-center text-muted py-3">No pending requests.</div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mt-4">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-bag-check text-primary me-1"></i> Approved - Awaiting Pickup</h4>
                <span class="badge bg-primary rounded-pill">@Model.Approved.Count Approved</span>
            </div>

            <div class="d-flex flex-column gap-3" data-paged="1">
                @foreach (var r in Model.Approved)
                {
                    <div class="p-3 res-card is-approved" data-page-item>
                        <div class="res-body mb-3">
                            <div class="res-details">
                                <h5 class="fw-bold mb-0">@r.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small d-block mb-2">Code: @r.EquipmentItem.ItemCode</span>
                                <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>@r.Borrower.FirstName @r.Borrower.LastName</strong> (@r.Borrower.UserId)</div>
                                <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>@($"{r.RequestedPickupDate:MMM d, yyyy - h:mm tt}")</strong></div>
                                <div class="small text-muted"><i class="bi bi-clock me-1"></i> Est. Return: <strong>@($"{r.EstimatedReturnDate:MMM d, yyyy - h:mm tt}")</strong></div>
                            </div>
                            <div class="res-side">
                                @{ Thumb(r.EquipmentItem); }
                            </div>
                        </div>
                        <form method="post" asp-controller="Custodian" asp-action="ReleaseItem">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            @if (Model.ReleaseUnits.TryGetValue(r.Id, out var units))
                            {
                                @* Several units of this model are free: hand over whichever one is at hand *@
                                <label class="dash-stat-label mb-1" for="unit-@r.Id">Unit to hand over</label>
                                <select name="unitId" id="unit-@r.Id" class="form-select form-select-sm dash-search-input mb-2">
                                    @foreach (var u in units)
                                    {
                                        <option value="@u.Id" selected="@(u.Id == r.EquipmentItemId)">
                                            @u.ItemCode@(u.Id == r.EquipmentItemId ? " (assigned)" : "")
                                        </option>
                                    }
                                </select>
                            }
                            <button type="submit" class="btn btn-sm dash-btn-reserve w-100 fw-bold">
                                <i class="bi bi-box-arrow-right me-1"></i> Release Item to Borrower
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-2" data-bs-toggle="modal" data-bs-target="#cancelApprovedModal" data-id="@r.Id">
                            <i class="bi bi-x-circle me-1"></i> Cancel Reservation
                        </button>
                    </div>
                }
                @if (!Model.Approved.Any())
                {
                    <div class="text-center text-muted py-3">Nothing waiting for pickup.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="dash-card">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-box-arrow-up-right text-success me-1"></i> Active Borrowings (Out on Loan)</h4>
                <span class="badge bg-success rounded-pill">@Model.Active.Count Active</span>
            </div>

            <div class="d-flex flex-column gap-3" data-paged="2">
                @foreach (var t in Model.Active)
                {
                    var now = DateTime.Now;
                    var due = t.Reservation?.EstimatedReturnDate;
                    var pastDue = due.HasValue && due.Value < now;
                    var overdue = pastDue && due.Value.AddMinutes(Model.GraceMinutes) < now;
                    var dueSoon = due.HasValue && !pastDue && due.Value <= now.AddHours(Model.DueSoonHours);
                    <div class="p-3 res-card @(overdue ? "is-overdue" : (pastDue || dueSoon) ? "is-warning" : "is-active")" data-page-item>
                        <div class="res-body mb-3">
                            <div class="res-details">
                                <h5 class="fw-bold mb-0">@t.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small d-block mb-2">Code: @t.EquipmentItem.ItemCode</span>
                                <div class="small text-muted mb-2"><i class="bi bi-person-check me-1"></i> Issued To: <strong>@t.Borrower.FirstName @t.Borrower.LastName</strong> (@t.Borrower.UserId)</div>
                                <div class="small text-muted mb-2"><i class="bi bi-box-arrow-right me-1"></i> Handover Time: <strong>@($"{t.ActualPickupTime:MMM d, yyyy - h:mm tt}")</strong></div>
                                <div class="small text-muted"><i class="bi bi-alarm me-1"></i> Due Return: <strong class="@(overdue ? "text-danger" : "")">@($"{due:MMM d, yyyy - h:mm tt}")</strong></div>
                            </div>
                            <div class="res-side">
                            @if (overdue)
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else if (pastDue)
                            {
                                <span class="badge bg-warning text-dark">Past due (grace period)</span>
                            }
                            else if (dueSoon)
                            {
                                <span class="badge bg-warning text-dark">Due soon</span>
                            }
                            else
                            {
                                <span class="dash-pill is-borrowed">Borrowed</span>
                            }
                                @{ Thumb(t.EquipmentItem); }
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal" data-id="@t.Id">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Inspect & Mark as Returned
                        </button>
                    </div>
                }
                @if (!Model.Active.Any())
                {
                    <div class="text-center text-muted py-3">No items are currently out on loan.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div class="modal fade" id="declineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-danger">Decline Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="DeclineRequest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Please specify a reason for declining this reservation request:</p>
                        <textarea name="declineReason" class="form-control dash-search-input" rows="3" placeholder="e.g. Equipment scheduled for maintenance during requested period..." required></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger fw-bold">Confirm Decline</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="cancelApprovedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-danger">Cancel Approved Reservation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="CancelApprovedReservation">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-2">The borrower will see this reason. Use it for no-shows or when the item can't be released (3 to 255 characters):</p>
                        <textarea name="cancelReason" class="form-control dash-search-input" rows="3" minlength="3" maxlength="255" placeholder="e.g. Borrower did not pick up the item..." required></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep Reservation</button>
                        <button type="submit" class="btn btn-danger fw-bold">Confirm Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold">Approve Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="ApproveRequest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Optionally add a note for the borrower (pickup instructions, reminders):</p>
                        <textarea name="reviewNotes" class="form-control dash-search-input" rows="3" placeholder="e.g. Please bring your school ID at pickup."></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn dash-btn-reserve fw-bold">Confirm Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-success">Inspect & Mark as Returned</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="ReturnItem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="dash-stat-label mb-1">Return Condition</label>
                            <select name="returnCondition" class="form-select dash-search-input" required>
                                <option value="good" selected>Good Condition</option>
                                <option value="minor_wear">Minor Wear & Tear</option>
                                <option value="needs_maintenance">Damaged - student must replace</option>
                            </select>
                            <div class="form-text">Choosing "Damaged" requires the student to replace the item within 14 days. Late returns are charged PHP 20 per day automatically.</div>
                        </div>
                        <div>
                            <label class="dash-stat-label mb-1">Damage / Inspection Notes</label>
                            <textarea name="damageNotes" class="form-control dash-search-input" rows="3" placeholder="Optional notes about the item's condition..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-bold">Confirm Return</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.modal').forEach(function (modal) {
            modal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var field = modal.querySelector('.modal-id');
                if (button && field) { field.value = button.getAttribute('data-id'); }
            });
        });

        // Pages each list (Pending, Approved, Active) so the cards don't grow endlessly.
        // data-paged="N" = cards per page; the pager only appears when there is more than one page.
        document.querySelectorAll('[data-paged]').forEach(function (list) {
            var size = parseInt(list.getAttribute('data-paged'), 10) || 3;
            var items = Array.prototype.filter.call(list.children, function (el) {
                return el.hasAttribute('data-page-item');
            });
            var pages = Math.ceil(items.length / size);
            if (pages <= 1) return;

            var nav = document.createElement('nav');
            nav.setAttribute('aria-label', 'Pages');
            var ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm dash-pagination res-pager justify-content-center mt-3 mb-0';
            nav.appendChild(ul);
            list.parentNode.insertBefore(nav, list.nextSibling);

            function pageButton(label, target, disabled, active, ariaLabel) {
                var li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                var a = document.createElement('a');
                a.className = 'page-link';
                a.textContent = label;
                if (ariaLabel) a.setAttribute('aria-label', ariaLabel);
                if (!disabled && !active) {
                    a.addEventListener('click', function (e) { e.preventDefault(); show(target); });
                }
                li.appendChild(a);
                return li;
            }

            function show(page) {
                items.forEach(function (el, i) {
                    el.classList.toggle('d-none', Math.floor(i / size) !== page);
                });
                ul.textContent = '';
                ul.appendChild(pageButton('‹', page - 1, page === 0, false, 'Previous'));
                for (var p = 0; p < pages; p++) {
                    ul.appendChild(pageButton(String(p + 1), p, false, p === page));
                }
                ul.appendChild(pageButton('›', page + 1, page === pages - 1, false, 'Next'));
            }

            show(0);
        });
    </script>
}